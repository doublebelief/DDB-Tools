# Copy OUTSIDE the repository; chmod 600. Never put these values in VITE_* variables.
AI_ORIGINS=https://doubledatabase.me,https://doubledatabase.cn
# SHA-256 digest of a randomly generated access token (at least 32 random bytes).
AI_ACCESS_HASH=
# Full HTTPS Chat Completions endpoint, including /chat/completions.
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
# Writable by the service user; daily quota persists across restarts.
AI_QUOTA_FILE=/var/lib/example-ai/quota.json
